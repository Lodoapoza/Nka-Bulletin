# =============================================================================
# .htaccess — Nka Bulletin (o2switch, Apache + Phusion Passenger 6)
# Bloc Passenger CloudLinux (format identique à celui de Setup Node.js App)
# + compression + cache long + sécurité passive.
#
# ⚠️ CE BLOC PASSENGER EST OBLIGATOIRE ET FRAGILE :
#   - PassengerAppType node ET PassengerStartupFile server.js sont REQUIS.
#   - S'ils manquent, mod_passenger ignore l'app → /api/* renvoie 404 Apache.
#   - Ne PAS écraser ce fichier sans reporter le bloc complet ci-dessous.
# =============================================================================

# --- Passenger : backend Node.js sur /api ------------------------------------
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerEnabled on
PassengerAppRoot "/home2/sc3sidaou/nka-bulletin.glocal-innov.com/nka-bulletin/backend"
PassengerBaseURI "/api"
PassengerNodejs "/opt/alt/alt-nodejs20/root/usr/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# --- Sécurité passive ---------------------------------------------------------
Options -Indexes

# Bloque l'accès aux fichiers cachés (.htaccess, .env, .git, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Compression -------------------------------------------------------------

# Compression gzip via mod_deflate (Apache / LiteSpeed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Fallback mod_gzip (anciens serveurs)
<IfModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_item include mime ^text/html$
  mod_gzip_item include mime ^text/css$
  mod_gzip_item include mime ^application/javascript$
  mod_gzip_item include mime ^application/json$
  mod_gzip_item include mime ^image/svg\+xml$
</IfModule>

# --- Cache -------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On

  # Assets versionnés par hash de contenu (?v=) : cache long (1 an)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # index.html : jamais mis en cache — revalidation systématique
  <FilesMatch "^(index\.html|sworker\.js|manifest\.json)$">
    ExpiresDefault "access plus 0 seconds"
    <IfModule mod_headers.c>
      Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
  </FilesMatch>
</IfModule>