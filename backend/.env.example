# ==== Copier ce fichier en ".env" et renseigner de VRAIES valeurs ====

# Port du serveur
PORT=4000

# Secret pour signer les tokens de session (générer avec: openssl rand -hex 32)
JWT_SECRET=change_me_with_a_real_random_64_char_hex_string

# Clé de chiffrement AES-256 pour stocker les identifiants IMAP en base
# (générer avec: openssl rand -hex 32)
CRYPTO_SECRET=change_me_with_a_real_32_byte_hex_key

# Clés VAPID pour les notifications Web Push (générer avec: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:contact@example.com

# Dossier de stockage des PDF téléchargés
STORAGE_DIR=./storage

# Chemin de la base SQLite
DB_PATH=./data/nka-bulletin.sqlite
