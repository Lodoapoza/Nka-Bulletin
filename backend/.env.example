# ==== Copier ce fichier en ".env" et renseigner de VRAIES valeurs ====
# En production sur o2switch : PORT est ignoré (Passenger gère le port)
# Mais définir NODE_ENV=production active les optimisations

# Environnement
NODE_ENV=production

# Port du serveur (développement local uniquement — ignoré par Passenger sur o2switch)
PORT=4000

# Secret pour signer les tokens de session (générer avec: openssl rand -hex 32)
# DOIT faire 64 caractères hex (32 bytes) minimum
JWT_SECRET=change_me_with_a_real_random_64_char_hex_string

# Clé de chiffrement AES-256 pour stocker les identifiants IMAP en base
# (générer avec: openssl rand -hex 32)
# DOIT faire 64 caractères hex (32 bytes) exactement
CRYPTO_SECRET=change_me_with_a_real_32_byte_hex_key

# Clés VAPID pour les notifications Web Push (générer avec: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:contact@glocal-innov.com

# OAuth2 Google (optionnel — pour "Se connecter avec Gmail" sans mot de passe d'application)
# Créer un projet sur Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized redirect URI: https://nka-bulletin.glocal-innov.com/api/auth/google/callback
# Scopes requis: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dossier de stockage des PDF téléchargés (doit être persistant sur o2switch)
# Sur o2switch : /home2/sc3sidaou/nka-bulletin.glocal-innov.com/nka-bulletin/backend/storage
STORAGE_DIR=./storage

# Chemin de la base SQLite (doit être sur disque persistant)
# Sur o2switch : /home2/sc3sidaou/nka-bulletin.glocal-innov.com/nka-bulletin/backend/data/nka-bulletin.sqlite
DB_PATH=./data/nka-bulletin.sqlite

# Timeout des requêtes IMAP par chunk (ms) — défaut 10 min
# Pour gros scans initiaux, peut être augmenté (ex: 300000 = 5 min)
SYNC_TIMEOUT=600000

# Fenêtre initiale de scan (jours) — défaut 1825 (5 ans)
# Un scan historique plus ancien peut être lancé année par année depuis le PWA.
INITIAL_SCAN_DAYS=1825

# Interrogation worker (ms) — défaut 2000
WORKER_POLL_INTERVAL=2000
